# 빅터홍컴퍼니 AI 투자회사 — 비밀 설정 예제
# `aifund setup`이 이 파일을 .env로 복사하고 관리자 토큰을 생성합니다.
# .env는 절대 Git에 올리지 마세요(.gitignore에 포함). 값은 화면·로그·AI 입력에 표시되지 않습니다.
# offline_demo 모드는 아래 거래소·시세·AI·뉴스 키를 읽지 않습니다.

# 기본 운용 모드: offline_demo | internal_paper | broker_sandbox | live
AIFUND_MODE=internal_paper

# 대시보드 관리자 토큰(setup이 자동 생성). 제어·설정 변경 로그인에 사용.
AIFUND_ADMIN_TOKEN=

# ---------------- AI (선택, 주문 권한 없음) ----------------
# 비워 두면 AI 없이 규칙 전략만 동작(설정 ai.when_unavailable 정책 적용).
# 사용할 공급자는 설정의 ai.provider(config/paper.toml 기본: gemini, config/config.toml 예제 기본: anthropic).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 공급자·모델을 환경변수로 고정하려면(대시보드에 '환경변수 고정' 표시). 공급자와 모델은 같은 회사 것으로.
# AIFUND_AI_PROVIDER=gemini
# AIFUND_AI_MODEL=gemini-3.5-flash-lite
# 로컬 모델(선택): AIFUND_AI_PROVIDER=ollama, AIFUND_AI_MODEL=<모델명>
# OLLAMA_HOST=http://127.0.0.1:11434

# ---------------- 업비트 실거래 키 (live 모드에서만 읽힘) ----------------
# 권장: 업비트 '서브포켓'을 봇 전용으로 만들고, 그 포켓의 API 키에 [자산조회][주문조회][주문하기]만 부여.
# 출금 권한은 절대 주지 마세요. 키는 등록한 IP에서만 동작합니다(집 공인 IP 변경 시 재등록 필요).
UPBIT_LIVE_ACCESS_KEY=
UPBIT_LIVE_SECRET_KEY=

# ---------------- 한국투자증권 KIS ----------------
# 실거래(live 모드에서만 주문용으로 읽힘)
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_ACCOUNT_PRODUCT=01
# 공식 모의투자(broker_sandbox 모드에서만 읽힘)
KIS_SANDBOX_APP_KEY=
KIS_SANDBOX_APP_SECRET=
KIS_SANDBOX_ACCOUNT_NO=
KIS_SANDBOX_ACCOUNT_PRODUCT=01
# 시세 조회 전용(선택). 없으면 live 모드의 KIS_LIVE 키를 시세에만 재사용.
# 시장 설정 data_provider = "default"인 국내·미국주식 시세에 사용(키움을 쓰면 불필요).
KIS_DATA_APP_KEY=
KIS_DATA_APP_SECRET=

# ---------------- 키움증권 REST (시세·계좌 조회 전용, 주문 기능 없음) ----------------
# 시장 설정 data_provider = "kiwoom"인 국내·미국주식 시세에 사용(config/paper.toml 기본).
# mock = 모의투자 서버, real = 실전 서버. 환경을 바꾸면 그 환경의 키로 바꾸세요. live 모드에서는 mock 시세를 쓰지 않습니다.
KIWOOM_DATA_ENV=mock
KIWOOM_DATA_APP_KEY=
KIWOOM_DATA_APP_SECRET=

# ---------------- 뉴스·공시 (선택) ----------------
# 네이버 뉴스 검색 API(developers.naver.com, 무료 하루 25,000회). 설정 news.naver_enabled로 켭니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=

# ---------------- 알림 (선택, 본인 수신처만) ----------------
AIFUND_TELEGRAM_BOT_TOKEN=
AIFUND_TELEGRAM_CHAT_ID=
AIFUND_WEBHOOK_URL=

# ---------------- 원격 접속 (기본 비활성) ----------------
# 대시보드를 127.0.0.1 밖으로 열 때만. docs/operations-macos.md의 원격 접속 절 참고.
# AIFUND_ALLOW_REMOTE=1
